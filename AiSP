    function bukaModalCetakUtama(jenis = 'semua') {
        const m = pangkalanDataMurid.find(item => item.maklumat_peribadi.murid_id === muridAktifId) || pangkalanDataMurid[0];
        const p = m.maklumat_peribadi;
