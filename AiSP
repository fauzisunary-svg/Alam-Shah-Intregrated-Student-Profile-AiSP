    function kemasKiniDropdownMurid() {
        const dropdown = document.getElementById('pilihNamaMuridDropdown');
        const lblBil = document.getElementById('labelBilanganMurid');
        if (!dropdown) return;

        const tPilih = document.getElementById('pilihTingkatan') ? document.getElementById('pilihTingkatan').value : '';
        const kPilih = document.getElementById('pilihKelas') ? document.getElementById('pilihKelas').value : '';

        const muridDitapis = pangkalanDataMurid.filter(m => {
            const p = m.maklumat_peribadi;
            const matchT = !tPilih || p.tingkatan_tahun === tPilih;
            const matchK = !kPilih || p.kelas === kPilih;
            const matchCarian = !carianTeksMurid || 
                p.nama.toLowerCase().includes(carianTeksMurid) || 
                p.murid_id.includes(carianTeksMurid);
            return matchT && matchK && matchCarian;
        });

        if (lblBil) lblBil.textContent = `${muridDitapis.length} Murid`;

        dropdown.innerHTML = '';
        if (muridDitapis.length === 0) {
            dropdown.innerHTML = '<option value="">Tiada murid ditemui</option>';
            return;
        }

        const wujud = muridDitapis.some(m => m.maklumat_peribadi.murid_id === muridAktifId);
        if (!wujud && muridDitapis.length > 0) {
            muridAktifId = muridDitapis[0].maklumat_peribadi.murid_id;
        }

        muridDitapis.forEach((m, idx) => {
            const p = m.maklumat_peribadi;
            const opt = document.createElement('option');
            opt.value = p.murid_id;
            opt.textContent = `${idx + 1}. ${p.nama} (${p.kelas} - ${p.murid_id})`;
            if (p.murid_id === muridAktifId) opt.selected = true;
            dropdown.appendChild(opt);
        });

        muatDataMurid(muridAktifId);
    }

