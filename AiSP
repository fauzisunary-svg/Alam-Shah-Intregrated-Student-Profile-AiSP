    function navigasiMurid(arah) {
        const tPilih = document.getElementById('pilihTingkatan') ? document.getElementById('pilihTingkatan').value : '';
        const kPilih = document.getElementById('pilihKelas') ? document.getElementById('pilihKelas').value : '';

        const muridDitapis = pangkalanDataMurid.filter(m => {
            const matchT = !tPilih || m.maklumat_peribadi.tingkatan_tahun === tPilih;
            const matchK = !kPilih || m.maklumat_peribadi.kelas === kPilih;
            return matchT && matchK;
        });

        if (muridDitapis.length <= 1) return;

        let currentIndex = muridDitapis.findIndex(m => m.maklumat_peribadi.murid_id === muridAktifId);
        if (arah === 'seterusnya') {
            currentIndex = (currentIndex + 1) % muridDitapis.length;
        } else if (arah === 'sebelum') {
            currentIndex = (currentIndex - 1 + muridDitapis.length) % muridDitapis.length;
        }

        muridAktifId = muridDitapis[currentIndex].maklumat_peribadi.murid_id;
        const dropdown = document.getElementById('pilihNamaMuridDropdown');
        if (dropdown) dropdown.value = muridAktifId;
        muatDataMurid(muridAktifId);
        binaJadualMasterRujukan();
    }

