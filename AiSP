        setSafeText('printSekolahNama', tetapanGuruPentadbir.pengetua.sekolah);
        setSafeText('printNamaMurid', p.nama);
        setSafeText('printKpMurid', p.murid_id);
        setSafeText('printKelasMurid', `${p.tingkatan_tahun} - ${p.kelas}`);
        setSafeText('printJantinaMurid', p.jantina);
        setSafeText('printSesMurid', p.status_sosioekonomi);
        setSafeText('printKehadiranMurid', `${p.peratus_kehadiran}%`);

        setSafeText('printAliranNama', m.aliran_disyorkan);
        setSafeText('printKerjayaPilihan', m.kerjaya_pilihan || "Jurutera Robotik & Automasi");

        const guruKelasObj = tetapanGuruPentadbir.guruKelasMap[p.kelas] || { nama: "Pn. Norziana binti Salleh", jawatan: `Guru Kelas ${p.kelas}` };
        setSafeText('printTandatanganGuruKelas', guruKelasObj.nama);
        setSafeText('printJawatanGuruKelas', guruKelasObj.jawatan);
        setSafeText('printTandatanganGbk', tetapanGuruPentadbir.gbk.nama);
        setSafeText('printTandatanganPengetua', tetapanGuruPentadbir.pengetua.nama);

        const bSegak = document.getElementById('printBahagianSegakKhusus');
        const bHem = document.getElementById('printBahagianHemKhusus');
        const bKoku = document.getElementById('printBahagianKokuKhusus');
        const bPbd = document.getElementById('printBahagianPbdKhusus');
        const bPp = document.getElementById('printBahagianPpKhusus');

        if (bSegak) bSegak.classList.add('hidden');
        if (bHem) bHem.classList.add('hidden');
        if (bKoku) bKoku.classList.add('hidden');
        if (bPbd) bPbd.classList.add('hidden');
        if (bPp) bPp.classList.add('hidden');

        const tajukEl = document.getElementById('printTajukDokumen');
        const subtajukEl = document.getElementById('printSubtajukDokumen');

        if (jenis === 'segak') {
            if (tajukEl) tajukEl.textContent = "SLIP UJIAN STANDARD KECERGASAN FIZIKAL KEBANGSAAN (SEGAK)";
            if (subtajukEl) subtajukEl.textContent = "Pentaksiran Komposisi Badan BMI & Bateri Ujian Standard KPM";
            if (bSegak) bSegak.classList.remove('hidden');

            setSafeText('printSegakTinggi', `${m.segak.tinggi} cm`);
            setSafeText('printSegakBerat', `${m.segak.berat.toFixed(1)} kg`);
            setSafeText('printSegakBmi', m.segak.bmi.toFixed(2));
            setSafeText('printSegakStatusBmi', m.segak.status_bmi);

            const tb = document.getElementById('printJadualSegakBadan');
            if (tb) {
                tb.innerHTML = (m.segak.bateri || []).map(b => `
                    <tr>
                        <td class="p-2 font-bold">${b.nama}</td>
                        <td class="p-2 text-center">${b.ukuran}</td>
                        <td class="p-2 text-center font-bold">${b.markah}/5</td>
                        <td class="p-2">${b.tafsiran}</td>
                    </tr>
                `).join('');
            }
        } else if (jenis === 'hem') {
            if (tajukEl) tajukEl.textContent = "SLIP PROFIL & REKOD HAL EHWAL MURID (HEM)";
            if (subtajukEl) subtajukEl.textContent = "Kesihatan, Disiplin (SSDM), Bantuan Persekolahan & Biasiswa";
            if (bHem) bHem.classList.remove('hidden');

            const kes = hem.kesihatan || {};
            const dis = hem.disiplin || {};
            const ban = hem.bantuan || {};
            const bia = hem.biasiswa || {};

            setSafeText('printHemKesihatanAm', kes.taraf_am);
            setSafeText('printHemImunisasi', kes.imunisasi);
            setSafeText('printHemAlahan', kes.alahan);
            setSafeText('printHemDisiplinTaraf', dis.taraf_sahsiah);
            setSafeText('printHemMataMerit', `+${dis.mata_merit || 0} Mata`);
            setSafeText('printHemMataDemerit', `${dis.mata_demerit || 0} Mata`);
            setSafeText('printHemSpbt', ban.spbt);
            setSafeText('printHemBap', ban.bap);
            setSafeText('printHemTakaful', ban.takaful);
            setSafeText('printHemJenisBiasiswa', bia.jenis);
            setSafeText('printHemKadarBiasiswa', bia.kadar);
            setSafeText('printHemStatusBiasiswa', bia.status);
        } else if (jenis === 'koku') {
            if (tajukEl) tajukEl.textContent = "SLIP PENTAKSIRAN AKTIVITI JASMANI, SUKAN & KOKURIKULUM (PAJSK)";
            if (subtajukEl) subtajukEl.textContent = "Pengiraan Markah Wajaran 10% Kokurikulum KPM";
            if (bKoku) bKoku.classList.remove('hidden');

            setSafeText('printPajskSkor10', `${m.kokurikulum.skor_10.toFixed(2)} / 10%`);
            setSafeText('printPajskGred', `GRED ${m.kokurikulum.gred}`);
            setSafeText('printPajskEkstraKoku', m.kokurikulum.ekstra);
        } else if (jenis === 'pbd') {
            if (tajukEl) tajukEl.textContent = "SLIP PENTAKSIRAN BILIK DARJAH (PBD)";
            if (subtajukEl) subtajukEl.textContent = "Tahap Penguasaan Standard Prestasi Bersepadu (SPPB)";
            if (bPbd) bPbd.classList.remove('hidden');

            const tb = document.getElementById('printJadualPbdBadan');
            if (tb) {
                tb.innerHTML = (m.pentaksiran_bilik_darjah || []).map(b => `
                    <tr>
                        <td class="p-2 font-bold">${b.subjek}</td>
                        <td class="p-2 text-center font-bold text-sky-800">TP${b.tp}</td>
                        <td class="p-2">${b.tafsiran}</td>
                    </tr>
                `).join('');
            }
        } else if (jenis === 'pp') {
            if (tajukEl) tajukEl.textContent = "SLIP PENTAKSIRAN SUMATIF PEPERIKSAAN BERPUSAT";
            if (subtajukEl) subtajukEl.textContent = "Pencapaian Gred Peperiksaan Lembaga Peperiksaan Malaysia";
            if (bPp) bPp.classList.remove('hidden');

            const tb = document.getElementById('printJadualPpBadan');
            if (tb) {
                tb.innerHTML = (m.pentaksiran_pusat || []).map(b => `
                    <tr>
                        <td class="p-2 font-bold">${b.subjek}</td>
                        <td class="p-2 text-center font-bold text-emerald-800">Gred ${b.gred}</td>
                        <td class="p-2">${b.status}</td>
                    </tr>
                `).join('');
            }
        } else {
            if (tajukEl) tajukEl.textContent = "SLIP PROFIL & LAPORAN HOLISTIK MURID (5-DOMAIN)";
            if (subtajukEl) subtajukEl.textContent = "Diselaraskan Mengikut Standard Pengurusan Pentaksiran Bersepadu KPM";
            if (bSegak) bSegak.classList.remove('hidden');
            if (bHem) bHem.classList.remove('hidden');
            if (bKoku) bKoku.classList.remove('hidden');
        }

        const modal = document.getElementById('modalPratontonCetak');
        if (modal) modal.classList.remove('hidden');
    }

    function tutupModalPratontonCetak() {
        const modal = document.getElementById('modalPratontonCetak');
