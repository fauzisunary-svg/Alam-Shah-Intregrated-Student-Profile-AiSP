    function bacaFailJson(e) {
        const fail = e.target.files[0];
        if (!fail) return;
        const reader = new FileReader();
        reader.onload = function(evt) {
            try {
                const data = JSON.parse(evt.target.result);
                if (Array.isArray(data)) {
                    pangkalanDataMurid = data;
                    muridAktifId = data[0].maklumat_peribadi.murid_id;
                    inisialisasiSistem();
                }
            } catch (err) {
                console.error("Fail JSON tidak sah:", err);
            }
        };
        reader.readAsText(fail);
    }

