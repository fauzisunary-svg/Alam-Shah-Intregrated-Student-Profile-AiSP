    function binaStatistikSekolah() {
        const elTing = document.getElementById('statTingkatanContainer');
        const elJan = document.getElementById('statJantinaContainer');
        const elKel = document.getElementById('statKelasContainer');
        const elSes = document.getElementById('statSesContainer');

        if (!elTing || !elJan || !elKel || !elSes) return;

        let total = pangkalanDataMurid.length;
        let tingMap = {}, janMap = {}, kelMap = {}, sesMap = {};
        pangkalanDataMurid.forEach(m => {
            const p = m.maklumat_peribadi;
            tingMap[p.tingkatan_tahun] = (tingMap[p.tingkatan_tahun] || 0) + 1;
            janMap[p.jantina] = (janMap[p.jantina] || 0) + 1;
            kelMap[p.kelas] = (kelMap[p.kelas] || 0) + 1;
            sesMap[p.status_sosioekonomi] = (sesMap[p.status_sosioekonomi] || 0) + 1;
        });

        elTing.innerHTML = Object.entries(tingMap).map(([k, v]) => {
            const pct = Math.round((v / total) * 100);
            return `
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-600 font-medium">${k}</span>
                        <strong class="text-slate-800 font-bold">${v} (${pct}%)</strong>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-indigo-600 h-full rounded-full" style="width: ${pct}%"></div>
                    </div>
                </div>
            `;
        }).join('');

        elJan.innerHTML = Object.entries(janMap).map(([k, v]) => {
            const pct = Math.round((v / total) * 100);
            const isLelaki = k.toLowerCase().includes('lelaki');
            return `
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-600 font-medium flex items-center gap-1">
                            <i class="fa-solid ${isLelaki ? 'fa-mars text-blue-500' : 'fa-venus text-rose-500'}"></i>${k}
                        </span>
                        <strong class="text-slate-800 font-bold">${v} (${pct}%)</strong>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
                        <div class="${isLelaki ? 'bg-blue-500' : 'bg-rose-500'} h-full rounded-full" style="width: ${pct}%"></div>
                    </div>
                </div>
            `;
        }).join('');

        elKel.innerHTML = Object.entries(kelMap).map(([k, v]) => {
            const pct = Math.round((v / total) * 100);
            return `
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-600 font-medium">${k}</span>
                        <strong class="text-slate-800 font-bold">${v} murid</strong>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-teal-600 h-full rounded-full" style="width: ${pct}%"></div>
                    </div>
                </div>
            `;
        }).join('');

        elSes.innerHTML = Object.entries(sesMap).map(([k, v]) => {
            const pct = Math.round((v / total) * 100);
            const warnaBg = k === 'B40' ? 'bg-rose-500' : (k === 'M40' ? 'bg-amber-500' : 'bg-emerald-500');
            return `
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-600 font-medium">${k}</span>
                        <strong class="text-slate-800 font-bold">${v} (${pct}%)</strong>
                    </div>
                    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
                        <div class="${warnaBg} h-full rounded-full" style="width: ${pct}%"></div>
                    </div>
                </div>
            `;
        }).join('');
    }

